#!/system/bin/sh

cache_cleaner() {
  # ===================================================
  #   ApacheCortex Cache Cleaner — Integrated Edition
  #   Terintegrasi dengan ekosistem qiunix (whitelist,
  #   game_list, foreground-detection) supaya nggak
  #   nyikat data yang seharusnya dilindungi.
  # ===================================================
  
  STATE_DIR="/data/local/tmp/qiunix_vixun"
  WHITELIST="/data/local/tmp/whitelist_pkg.txt"
  GAME_LIST="/data/local/tmp/game.txt"
  LOCK_FILE="/data/local/tmp/.cache_cleaner.lock"
  QUIET="${1:-}"   # panggil dengan "--quiet" buat mode otomatis (skip RAM benchmark)
  
  pkg="com.android.systemui"
  
  if [ -f "$LOCK_FILE" ]; then
    old_pid=$(cat "$LOCK_FILE" 2>/dev/null)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        echo "[!] Cache cleaner sudah berjalan (PID $old_pid), batal."
        exit 1
    fi
  fi
  echo "$$" > "$LOCK_FILE"
  trap 'rm -f "$LOCK_FILE"' EXIT
  
  # ===================================================
  #   GUARD 1: Jangan jalan kalau device lagi dipakai
  #   main game (skip total, bukan cuma skip 1 app) —
  #   scan cache yang berat + drop_caches bisa bikin
  #   stutter kalau dipaksa jalan pas sesi aktif.
  # ===================================================
  if [ -f "$GAME_LIST" ]; then
    fg_pkg=$(dumpsys activity activities 2>/dev/null \
        | grep -m1 -E "mResumedActivity|ResumedActivity" \
        | grep -oE "[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)+/[a-zA-Z0-9_.]+" \
        | head -1 | cut -d/ -f1)
    if [ -n "$fg_pkg" ] && grep -qx "$fg_pkg" "$GAME_LIST" 2>/dev/null; then
        echo "[!] $fg_pkg lagi dimainkan — cache cleaner ditunda."
        exit 0
    fi
  fi
  
  # ===================================================
  #   Kumpulin daftar package yang AMAN buat dibersihkan
  #   (exclude: whitelist user + semua game di game_list)
  # ===================================================
  USER_PKGS_RAW=$(pm list packages --user 0 2>/dev/null | sed 's/package://')
  
  is_protected() {
    local p="$1"
    [ -f "$WHITELIST" ] && grep -qx "$p" "$WHITELIST" 2>/dev/null && return 0
    [ -f "$GAME_LIST" ] && grep -qx "$p" "$GAME_LIST" 2>/dev/null && return 0
    return 1
  }
  
  USER_PKGS=""
  for p in $USER_PKGS_RAW; do
    is_protected "$p" && continue
    USER_PKGS="$USER_PKGS $p"
  done
  
  
  # ===================================================
  #   RAM SCAN — dilewati kalau mode --quiet (otomatis)
  #   karena scan per-app itu mahal & cuma buat display,
  #   nggak mempengaruhi hasil cleaning sama sekali.
  # ===================================================
  toMB() { echo $(( ($1 + 512) / 1024 )); }
  
  get_mem_sysui() {
    dumpsys meminfo "$pkg" 2>/dev/null | grep "TOTAL PSS" | awk '{print $3}'
  }
  
  if [ "$QUIET" != "--quiet" ]; then
    echo ""
    echo "🔍 Mengambil RAM SystemUI (SEBELUM)..."
    before_sysui=$(get_mem_sysui); before_sysui=${before_sysui:-0}
    echo "SystemUI Sebelum : $(toMB "$before_sysui") MB"
  
    # Total RAM sistem sekali panggil, BUKAN loop per-app (jauh lebih
    # murah — versi lama manggil dumpsys meminfo per-package, bisa
    # ratusan kali panggilan cuma buat angka display).
    echo ""
    echo "🔍 Ringkasan RAM sistem (SEBELUM)..."
    before_summary=$(dumpsys meminfo 2>/dev/null | grep -A1 "Total RAM:" | head -2)
    echo "$before_summary"
  fi
  
  
  # ===================================================
  #   OPTIMIZATION STEPS
  # ===================================================
  echo ""
  echo "[!] Killing cached apps..."
  am kill-all 2>/dev/null
  sleep 1
  
  # ======= LOGGING / DROPBOX / TRACING =======
  # Sengaja TIDAK diimplementasi ulang di sini — qiunix sudah punya
  # disable_runtime_logging() & disable_misc_settings_once() yang lebih
  # lengkap (dengan marker file buat restore). Cukup panggil kalau
  # fiturnya aktif, biar nggak ada 2 sumber kebenaran yang bisa bentrok.
  if command -v qiunix >/dev/null 2>&1; then
    [ "$(qiunix --runtime-logging --get 2>/dev/null)" = "1" ] && qiunix --tweak runtime-logging
    [ "$(qiunix --misc-settings --get 2>/dev/null)" = "1" ]   && qiunix --tweak misc-settings
  fi
  
  
  # ===================================================
  #   CLEAR CACHE — hanya untuk package yang tidak
  #   diproteksi (bukan whitelist, bukan game)
  # ===================================================
  echo ""
  echo "🧹 Membersihkan cache aplikasi (di luar whitelist & game)..."
  
  for p in $USER_PKGS; do
    find "/data/data/$p/cache" -maxdepth 3 -type f -delete 2>/dev/null
    find "/data/data/$p/code_cache" -maxdepth 3 -type f -delete 2>/dev/null
  done
  
  find /data/user_de -mindepth 3 -maxdepth 4 -name "cache" -type d 2>/dev/null | while read -r dir; do
    # dir formatnya /data/user_de/0/<pkg>/cache -> ambil <pkg> buat cek proteksi
    owner_pkg=$(echo "$dir" | cut -d/ -f5)
    is_protected "$owner_pkg" && continue
    find "$dir" -maxdepth 2 -type f -delete 2>/dev/null
  done
  find /data/user_de -mindepth 3 -maxdepth 4 -name "code_cache" -type d 2>/dev/null | while read -r dir; do
    owner_pkg=$(echo "$dir" | cut -d/ -f5)
    is_protected "$owner_pkg" && continue
    find "$dir" -maxdepth 2 -type f -delete 2>/dev/null
  done
  
  # --- External storage cache: PALING RAWAN, banyak app nyimpen
  #     "download content" (bukan cache beneran) di folder ini ---
  find /sdcard/Android/data -mindepth 2 -maxdepth 3 -name "cache" -type d 2>/dev/null | while read -r dir; do
    owner_pkg=$(echo "$dir" | cut -d/ -f5)
    is_protected "$owner_pkg" && continue
    find "$dir" -maxdepth 2 -type f -delete 2>/dev/null
  done
  
  # Thumbnail cache (aman, regenerasi otomatis)
  rm -rf /sdcard/DCIM/.thumbnails/* 2>/dev/null
  
  
  # ================= GMS CACHE CLEANER ==================
  if ! is_protected "com.google.android.gms"; then
    echo "🧹 Membersihkan cache Google Mobile Services..."
    find /data/data/com.google.android.gms/cache -maxdepth 3 -type f -delete 2>/dev/null
    find /data/data/com.google.android.gms/code_cache -maxdepth 3 -type f -delete 2>/dev/null
    find /data/user_de/0/com.google.android.gms/cache -maxdepth 3 -type f -delete 2>/dev/null
    find /data/user_de/0/com.google.android.gms/code_cache -maxdepth 3 -type f -delete 2>/dev/null
  fi
  
  
  # ================= SYSTEM LEVEL CLEANUP ==================
  echo "🧹 Drop page cache (butuh root)..."
  sync
  if [ -w /proc/sys/vm/drop_caches ]; then
    echo 3 > /proc/sys/vm/drop_caches
    echo "[√] Page cache berhasil di-drop"
  else
    echo "[!] drop_caches tidak bisa diakses (SELinux atau bukan root)"
  fi
  
  pm trim-caches 1024G 2>/dev/null
  sleep 1
  
  
  # ===================================================
  #   RAM SCAN — SESUDAH (skip kalau --quiet)
  # ===================================================
  if [ "$QUIET" != "--quiet" ]; then
    echo ""
    echo "🔍 Mengambil RAM SystemUI (SESUDAH)..."
    after_sysui=$(get_mem_sysui); after_sysui=${after_sysui:-0}
    echo "[-] SystemUI Sesudah : $(toMB "$after_sysui") MB"
  
    echo ""
    echo "🔍 Ringkasan RAM sistem (SESUDAH)..."
    after_summary=$(dumpsys meminfo 2>/dev/null | grep -A1 "Total RAM:" | head -2)
    echo "[-] $after_summary"
  
    sysui_freed=$(( before_sysui - after_sysui ))
    echo ""
    echo "======================================="
    echo "📊 HASIL CLEANING"
    echo "======================================="
    echo "SystemUI : $(toMB "$before_sysui") MB → $(toMB "$after_sysui") MB (freed: $(toMB "$sysui_freed") MB)"
    echo "======================================="
  fi
  
  echo "[√] ApacheCortex Cleaning Done!"

}

cache_cleaner "$@" > /data/local/tmp/.apache_cache_cleaner