#!/system/bin/sh

# =================================================================
# Module: QiunixApache Cache Cleaner (Safe Version v4 — non-root aware)
# =================================================================

qiunix_cache_cleaner() {
    NC='\033[0m'
    B='\033[1m'
    G='\033[32m'
    DG='\033[1;32m'
    W='\033[37m'
    BW='\033[1;37m'
    GR='\033[90m'
    Y='\033[33m'
    R='\033[31m'

    # [FIX] printf '%b' konsisten interpret \033 escape lintas
    #     implementasi sh, beda dari `echo` yang perilakunya beda-beda
    #     (dash butuh -e eksplisit, mksh enggak) -- output warna bisa
    #     berantakan kalau device pakai shell yang gak auto-interpret.
    log_title()   { printf '%b\n' "\n${G}─[ ${BW}$1 ${G}]${NC}"; }
    log_sub()     { printf '%b\n' "${GR}├─▶ ${W}$1${NC}"; }
    log_item()    { printf '%b\n' "${GR}│   ├── ${W}$1${NC}"; }
    log_success() { printf '%b\n' "${GR}│   └── ${G}✓ $1${NC}"; }
    log_warn()    { printf '%b\n' "${GR}│   └── ${Y}! $1${NC}"; }
    log_skip()    { printf '%b\n' "${GR}│   └── ${R}✗ $1 (dilewati — butuh root)${NC}"; }

    # [FIX] deteksi root SEKALI di awal, konsisten dipakai buat gate
    #     semua operasi yang butuh akses /data/data, /data/user_de,
    #     dll -- bukan asumsi "kalau gak ada su, ya udah gagal diam2".
    HAS_ROOT="false"
    _root_test_file="/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
    if [ -w "$_root_test_file" ] 2>/dev/null; then
        _cur=$(cat "$_root_test_file" 2>/dev/null)
        if [ -n "$_cur" ] && echo "$_cur" > "$_root_test_file" 2>/dev/null; then
            HAS_ROOT="true"
        fi
    fi

    get_available_ram_mb() {
        mem_free=$(grep MemAvailable /proc/meminfo 2>/dev/null | awk '{print $2}')
        [ -z "$mem_free" ] && mem_free=$(grep MemFree /proc/meminfo 2>/dev/null | awk '{print $2}')
        echo $(( ${mem_free:-0} / 1024 ))
    }

    get_pkg_ram() {
        pkgname="$1"
        mem=$(dumpsys meminfo "$pkgname" 2>/dev/null | grep -E "TOTAL PSS:" | head -1 | awk '{print $3}')
        echo $(( ${mem:-0} / 1024 ))
    }

    clear
    printf '%b\n' "${G}┌──────────────────────────────────────────────────┐${NC}"
    printf '%b\n' "${G}│ ${BW}QiunixApache${NC} ${GR}System Cache Cleaner v4 (Safe)       ${G}│${NC}"
    printf '%b\n' "${G}└──────────────────────────────────────────────────┘${NC}"
    printf '%b\n' "${GR}Mode: $([ "$HAS_ROOT" = "true" ] && echo "${G}ROOT" || echo "${Y}NON-ROOT")${NC}"

    # 1. SCANNING BEFORE
    log_title "Analisis Memori Sistem"
    sys_ram_before=$(get_available_ram_mb)
    sysui_ram_before=$(get_pkg_ram "com.android.systemui")
    gms_ram_before=$(get_pkg_ram "com.google.android.gms")

    printf '%b\n' "${GR}├── ${W}RAM Bebas Sistem  : ${DG}${sys_ram_before} MB${NC}"
    printf '%b\n' "${GR}├── ${W}SystemUI Memory   : ${W}${sysui_ram_before} MB${NC}"
    printf '%b\n' "${GR}└── ${W}GMS Core Memory   : ${W}${gms_ram_before} MB${NC}"

    # 2. PROCESS & LOG TRIMMING
    log_title "Penghentian Process & Logging"
    log_sub "Membersihkan proses latar belakang (dengan safety check)..."

    # [FIX] am kill-all / cmd activity kill-all diganti pola yang sama
    #     kayak background_reaper -- cek oom_score_adj (skip proses
    #     foreground/critical), hormati whitelist, jangan bunuh buta.
    WHITELIST="/data/local/tmp/whitelist_pkg.txt"
    foreground_pkg=$(dumpsys activity processes 2>/dev/null | grep top-activity | cut -d':' -f4 | cut -d'/' -f1 | head -n1)
    killed_count=0

    for pkg in $(pm list packages -3 2>/dev/null | cut -d: -f2); do
        [ -z "$pkg" ] && continue
        [ "$pkg" = "$foreground_pkg" ] && continue
        if [ -f "$WHITELIST" ] && grep -qx "$pkg" "$WHITELIST"; then
            continue
        fi
        pid=$(pidof "$pkg" 2>/dev/null | awk '{print $1}')
        [ -z "$pid" ] && continue
        oom_adj=$(cat /proc/$pid/oom_score_adj 2>/dev/null)
        [ -z "$oom_adj" ] && continue
        if [ "$oom_adj" -le 0 ] 2>/dev/null; then continue; fi

        am kill "$pkg" 2>/dev/null
        killed_count=$((killed_count + 1))
    done
    log_success "Cached processes dihentikan ($killed_count app, whitelist & foreground dihormati)."

    log_sub "Mengosongkan buffer LogCat & System Tracing..."
    logcat -c 2>/dev/null
    atrace --async_stop >/dev/null 2>&1
    cmd activity trace-ipc stop 2>/dev/null
    cmd window tracing stop 2>/dev/null
    log_success "System logs & tracing di-reset."

    log_sub "Mematikan telemetri & kernel tracing..."
    # [FIX] backup nilai lama SEBELUM diubah, biar ada cara restore
    #     kalau ternyata ada setting yang gak dimaksud kesentuh
    BACKUP_FILE="/data/local/tmp/.qiunix_settings_backup_$(date +%Y%m%d_%H%M%S).txt"
    : > "$BACKUP_FILE"

    for b in $(cmd settings list global 2>/dev/null | cut -f1 -d= | grep -E "logging|dropbox"); do
        old_val=$(cmd settings get global "$b" 2>/dev/null)
        echo "global $b $old_val" >> "$BACKUP_FILE"
        cmd settings put global "$b" 0 2>/dev/null
    done
    for c in $(cmd settings list secure 2>/dev/null | cut -f1 -d= | grep -E "logging|dropbox"); do
        old_val=$(cmd settings get secure "$c" 2>/dev/null)
        echo "secure $c $old_val" >> "$BACKUP_FILE"
        cmd settings put secure "$c" 0 2>/dev/null
    done
    for trace_path in /sys/kernel/tracing/tracing_on /sys/kernel/debug/tracing/tracing_on; do
        [ -w "$trace_path" ] && echo 0 > "$trace_path"
    done
    log_success "Kernel tracing dinonaktifkan (backup nilai lama: $BACKUP_FILE)."

    # 3. JUNK & CACHE CLEANING
    log_title "Pembersihan Cache & Sampah Sistem"

    if [ "$HAS_ROOT" = "true" ]; then
        log_sub "Membersihkan cache aplikasi internal (/data/data) [ROOT]..."
        find /data/data/ -mindepth 2 -maxdepth 2 -type d \( -name "cache" -o -name "code_cache" \) 2>/dev/null | xargs rm -rf 2>/dev/null
        log_success "Cache internal aplikasi dibersihkan."

        log_sub "Membersihkan user DE cache (/data/user_de) [ROOT]..."
        find /data/user_de/ -mindepth 3 -maxdepth 3 -type d \( -name "cache" -o -name "code_cache" \) 2>/dev/null | xargs rm -rf 2>/dev/null
        log_success "Direct encryption caches dibersihkan."
    else
        # [FIX] non-root fallback: pm clear --cache-only per app,
        #     ini yang beneran nyampe ke internal cache tanpa root
        #     (lewat system_server, bukan raw filesystem access)
        # [FIX] paralel dengan batas concurrency, bukan satu-satu
        #     berurutan -- tiap `pm clear` spawn proses Java baru
        #     (JVM startup cost), kalau 50-150+ app dijalankan
        #     berurutan itu bisa numpuk jadi puluhan detik. Jalanin
        #     beberapa bareng (background job) sekaligus, capped biar
        #     gak overload CPU.
        log_sub "Membersihkan cache internal via pm clear --cache-only [NON-ROOT]..."
        MAX_PARALLEL=6
        cleared_marker="/data/local/tmp/.qiunix_cleared_count"
        : > "$cleared_marker"

        for pkg in $(pm list packages -3 2>/dev/null | cut -d: -f2); do
            [ -z "$pkg" ] && continue
            if [ -f "$WHITELIST" ] && grep -qx "$pkg" "$WHITELIST"; then continue; fi

            (
              if pm clear --cache-only "$pkg" >/dev/null 2>&1; then
                echo 1 >> "$cleared_marker"
              fi
            ) &

            # batasi jumlah job paralel yang jalan bersamaan
            while [ "$(jobs -r | wc -l)" -ge "$MAX_PARALLEL" ]; do
              wait -n 2>/dev/null || sleep 0.1
            done
        done
        wait   # tunggu semua job sisa selesai sebelum lanjut

        cleared=$(wc -l < "$cleared_marker" 2>/dev/null)
        rm -f "$cleared_marker"
        log_success "Cache internal dibersihkan via pm ($cleared app)."
    fi

    log_sub "Membersihkan cache penyimpanan eksternal (/sdcard/Android)..."
    find /sdcard/Android/data/ -mindepth 2 -maxdepth 2 -type d \( -name "cache" -o -name "code_cache" \) 2>/dev/null | xargs rm -rf 2>/dev/null
    find /sdcard/Android/media/ -mindepth 2 -maxdepth 2 -type d \( -name "cache" -o -name "code_cache" \) 2>/dev/null | xargs rm -rf 2>/dev/null
    log_success "Cache eksternal dibersihkan."

    log_sub "Menghapus berkas sampah sistem & crash dumps..."
    if [ "$HAS_ROOT" = "true" ]; then
        log_item "Crash Dumps (/data/tombstones) [ROOT]"
        rm -rf /data/tombstones/* 2>/dev/null
        log_item "ANR Trace Logs (/data/anr) [ROOT]"
        rm -rf /data/anr/* 2>/dev/null
        log_item "System Dropbox Crash Logs (/data/system/dropbox) [ROOT]"
        rm -rf /data/system/dropbox/* 2>/dev/null
        log_item "System Log Daemon Cache (/data/misc/logd) [ROOT]"
        rm -rf /data/misc/logd/* 2>/dev/null
    else
        log_skip "Crash Dumps (/data/tombstones)"
        log_skip "ANR Trace Logs (/data/anr)"
        log_skip "System Dropbox Crash Logs (/data/system/dropbox)"
        log_skip "System Log Daemon Cache (/data/misc/logd)"
    fi

    log_item "Temporary Installer Cache (Filter Safe)"
    find /data/local/tmp/ -maxdepth 1 -type f \( -name "*.apk" -o -name "*.tmp" \) -exec rm -f {} + 2>/dev/null

    log_item "Thumbnails Galeri & Sampah (.thumbnails, .trash)"
    rm -rf /sdcard/DCIM/.thumbnails/* 2>/dev/null
    rm -rf /sdcard/Android/data/*/files/.trash/* 2>/dev/null
    log_success "Berkas sampah aman dibersihkan."

    log_sub "Deep cleaning Google Play Services (GMS)..."
    if [ "$HAS_ROOT" = "true" ]; then
        rm -rf /data/data/com.google.android.gms/cache/* 2>/dev/null
        rm -rf /data/data/com.google.android.gms/code_cache/* 2>/dev/null
        log_success "GMS Cache dibersihkan [ROOT]."
    else
        pm clear --cache-only com.google.android.gms >/dev/null 2>&1
        log_success "GMS Cache dibersihkan via pm [NON-ROOT]."
    fi

    log_sub "Menjalankan Package Manager Cache Trim..."
    # [FIX] angka byte mentah, bukan suffix "999G" yang gak jelas
    #     apakah beneran ke-parse bener oleh pm di semua device
    pm trim-caches 999999999999 2>/dev/null
    log_success "PM trim selesai."

    # 4. KERNEL MEMORY OPTIMIZATION
    log_title "Kernel & Memory Management"

    log_sub "Sinkronisasi file system (sync)..."
    sync
    log_success "Filesystem sync selesai."

    if [ "$HAS_ROOT" = "true" ]; then
        log_sub "Compacting RAM (Defragmentasi Memory) [ROOT]..."
        if [ -w /proc/sys/vm/compact_memory ]; then
            echo 1 > /proc/sys/vm/compact_memory
            log_success "RAM compaction dieksekusi."
        else
            log_warn "Compact memory tidak didukung kernel."
        fi

        log_sub "Clearing PageCache, Dentries & Inodes [ROOT]..."
        if [ -w /proc/sys/vm/drop_caches ]; then
            echo 3 > /proc/sys/vm/drop_caches
            log_success "drop_caches=3 dieksekusi."
        else
            log_warn "drop_caches tidak writable meski root aktif."
        fi
    else
        log_skip "RAM Compaction (/proc/sys/vm/compact_memory)"
        log_skip "Drop Caches (/proc/sys/vm/drop_caches)"
    fi

    sleep 1

    # 5. SUMMARY
    sys_ram_after=$(get_available_ram_mb)
    sysui_ram_after=$(get_pkg_ram "com.android.systemui")
    gms_ram_after=$(get_pkg_ram "com.google.android.gms")

    ram_gained=$(( sys_ram_after - sys_ram_before ))
    if [ "$ram_gained" -lt 0 ]; then
        ram_gained_str="0 MB (Reallocated)"
    else
        ram_gained_str="+${ram_gained} MB"
    fi

    log_title "Hasil Pembersihan QiunixApache"

    printf '%b\n' "${GR}┌───────────────────────────┬────────────────┬────────────────┐${NC}"
    printf '%b\n' "${GR}│ ${BW}Komponen                  ${GR}│ ${BW}Sebelum        ${GR}│ ${BW}Sesudah        ${GR}│${NC}"
    printf '%b\n' "${GR}├───────────────────────────┼────────────────┼────────────────┤${NC}"
    printf '%b\n' "${GR}│ ${W}RAM Bebas Sistem          ${GR}│ $(printf "%-14s" "${sys_ram_before} MB") │ ${DG}$(printf "%-14s" "${sys_ram_after} MB")${NC}${GR}│${NC}"
    printf '%b\n' "${GR}│ ${W}SystemUI RAM              ${GR}│ $(printf "%-14s" "${sysui_ram_before} MB") │ $(printf "%-14s" "${sysui_ram_after} MB") │${NC}"
    printf '%b\n' "${GR}│ ${W}Play Services (GMS)       ${GR}│ $(printf "%-14s" "${gms_ram_before} MB") │ $(printf "%-14s" "${gms_ram_after} MB") │${NC}"
    printf '%b\n' "${GR}└───────────────────────────┴────────────────┴────────────────┘${NC}"

    echo ""
    printf '%b\n' "${G}✓ ${BW}Peningkatan Memori : ${DG}${ram_gained_str}${NC}"
    printf '%b\n' "${G}✓ ${BW}Mode Eksekusi      : ${W}$([ "$HAS_ROOT" = "true" ] && echo "Root (penuh)" || echo "Non-root (sebagian di-skip, lihat tanda ✗ di atas)")${NC}"
    printf '%b\n' "${G}✓ ${BW}Status             : ${W}Optimasi QiunixApache Selesai.${NC}"
    echo ""
}

qiunix_cache_cleaner "$@"
